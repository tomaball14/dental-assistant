# demo (default) uses a fictional practice. Set to "live" for real PMS + clearinghouse data.
DATA_MODE=demo

# Required in live mode. Staff enter this code in the web app.
APP_ACCESS_CODE=

PRACTICE_NAME=Danville Dental Care
PRACTICE_TIMEZONE=America/New_York
PROVIDER_NPI=

# NexHealth Synchronizer API (PMS data: appointments, patients, insurance)
NEXHEALTH_API_KEY=
NEXHEALTH_SUBDOMAIN=
NEXHEALTH_LOCATION_ID=
# NEXHEALTH_API_VERSION=v3.0.0

# Stedi clearinghouse (real-time 270/271 dental eligibility)
STEDI_API_KEY=

# Office fee schedule in dollars, used when the PMS doesn't send a fee
# FEE_SCHEDULE_JSON={"D1110":110,"D2740":1250}

# Claude for the conversational assistant (falls back to keyword answers without it)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Texting (Twilio). Webhook: POST https://<domain>/api/sms
TWILIO_AUTH_TOKEN=
PUBLIC_BASE_URL=
ALLOWED_SMS_NUMBERS=
